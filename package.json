{
  "name": "@madronejs/core",
  "version": "2.0.5",
  "description": "Object composition and reactivity framework.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/core.umd.js",
  "module": "./dist/core.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.umd.cjs"
    },
    "./vue": {
      "types": "./types/integrations/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.umd.cjs"
    }
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "types/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/madronejs/madrone.git"
  },
  "bugs": {
    "url": "https://github.com/madronejs/madrone/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest",
    "test-ci": "CI=true NODE_ENV=test vitest run --coverage",
    "docs": "typedoc --entryPoints src/index.ts",
    "cleanup": "rm -rf ./dist/* && rm -rf ./types/*",
    "cov": "CI=true NODE_ENV=test vitest run --coverage && open coverage/lcov-report/index.html",
    "build": "vite build",
    "build-types": "tsc -p ./tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "build-all": "pnpm cleanup && pnpm build && pnpm build-types",
    "changelog:compile": "node scripts/compile-changelog.mjs",
    "check-updates": "pnpm -r --long outdated",
    "check-upgrade": "pnpm -r -i --latest update",
    "all": "pnpm build-types && pnpm lint && pnpm test-ci"
  },
  "keywords": [
    "reactivity",
    "composition",
    "state management",
    "madrone",
    "vue"
  ],
  "devDependencies": {
    "@babel/core": "~8.0.9",
    "@babel/plugin-proposal-decorators": "~8.0.2",
    "@babel/plugin-transform-typescript": "~8.0.6",
    "@eslint/compat": "~2.1.1",
    "@eslint/eslintrc": "~3.3.7",
    "@eslint/js": "~10.0.1",
    "@rolldown/plugin-babel": "~0.2.4",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/lodash": "~4.17.27",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "~10.13.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-unicorn": "~74.0.0",
    "globals": "~17.13.0",
    "happy-dom": "~21.0.4",
    "lodash": "~4.18.1",
    "tsc-alias": "~1.9.9",
    "typedoc": "~0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "vue3": "npm:vue@~3.5.44"
  },
  "engines": {
    "node": "^24.15 || ^26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
